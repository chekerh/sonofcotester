generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String    @id
  name        String
  description String
  projects    Project[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id          String    @id
  workspaceId String
  email       String    @unique
  name        String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id            String         @id
  workspaceId   String
  name          String
  description   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testSuites    TestSuite[]
  executionRuns ExecutionRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TestSuite {
  id          String          @id
  projectId   String
  sourceType  String
  summary     String
  versionId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  executions  ExecutionRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TestCase {
  id           String      @id
  suiteId       String
  title         String
  feature       String
  priority      String
  platform      String
  prerequisites Json
  tags          Json
  steps         Json
  suite         TestSuite   @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ExecutionRun {
  id               String            @id
  projectId        String
  suiteId          String
  suiteVersionId   String
  provider         String
  environment      String
  status           String
  matrix           Json
  artifacts        Json
  healingProposals HealingProposal[]
  bugReports       BugReport[]
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite            TestSuite         @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model HealingProposal {
  id          String       @id
  executionId String
  testCaseId  String
  status      String
  patch       String
  rationale   String
  signals     Json
  execution   ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BugReport {
  id              String       @id
  executionId     String
  title           String
  summary         String
  severity        String
  reproductionSteps Json
  evidence        Json
  execution       ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

