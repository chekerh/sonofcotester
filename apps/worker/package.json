{
  "name": "@sonofcotester/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sonofcotester/ai": "workspace:*",
    "@sonofcotester/automation": "workspace:*",
    "@sonofcotester/data": "workspace:*",
    "@sonofcotester/sdk": "workspace:*",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
