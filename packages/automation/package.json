{
  "name": "@sonofcotester/automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sonofcotester/sdk": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
