{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build", "^build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "PORT",
        "DEMO_TARGET_PORT",
        "VITE_API_URL",
        "BROWSERSTACK_USERNAME",
        "BROWSERSTACK_ACCESS_KEY",
        "BROWSERSTACK_APP_ID"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "format": {}
  }
}
