{
  "name": "sonofcotester",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:alpha": "turbo run dev --filter=@sonofcotester/demo-target --filter=@sonofcotester/api --filter=@sonofcotester/worker --filter=@sonofcotester/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "bash ./scripts/alpha-env.test.sh && turbo run test",
    "format": "turbo run format",
    "prisma:generate": "pnpm --filter @sonofcotester/data prisma:generate",
    "db:push": "pnpm --filter @sonofcotester/data exec prisma db push --schema prisma/schema.prisma",
    "run:alpha": "bash ./scripts/run-alpha.sh",
    "run:app": "bash ./run_app.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "typescript": "^5.7.3"
  }
}
