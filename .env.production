# ─── Son of CodeTester — Production Environment ───
# Copy this file and fill in real values before deploying.
# Usage: cp .env.production .env.production.local && vim .env.production.local

# ── Database ──
POSTGRES_USER=sonofcotester
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=sonofcotester
DATABASE_URL=postgresql://sonofcotester:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── API ──
PORT=3001
NODE_ENV=production

# ── CORS (comma-separated origins, or leave empty to disable) ──
CORS_ORIGIN=https://yourdomain.com

# ── Web ──
WEB_PORT=80
VITE_API_URL=/api

# ── GitHub Integration ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Jira Integration ──
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── AI / OpenAI (for test generation) ──
OPENAI_API_KEY=

# ── BrowserStack (for web/mobile testing) ──
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# ── Maestro Cloud (for mobile UI testing) ──
MAESTRO_API_KEY=
MAESTRO_PROJECT_ID=
